{
  "manifest_version": 3,
  "name": "FoxGEN Pro",
  "version": "5.40.0",
  "description": "FoxGEN Pro 5.40 \u2014 workspace tools with FoxGEN licence activation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "cookies",
    "alarms",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://bundlee.store/*",
    "https://*.lovable.app/*",
    "https://*.eklas.dev/*",
    "https://keygen.eklas.dev/*",
    "https://hzlajptzsscmzjblodgb.supabase.co/*",
    "https://ultraxlovableilimitado.vercel.app/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.deepseek.com/*",
    "https://api.mistral.ai/*",
    "https://api.x.ai/*",
    "https://api.together.xyz/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FoxGEN Pro 5.40"
  },
  "background": {
    "service_worker": "foxgen-service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-250-balance-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-direct-support.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-direct-support.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": [
        "drag-blocker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-switch-support-whatsapp.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "jszip.min.js",
        "pageHook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-250-balance-isolated.js",
        "bundlee-clear-stale-update.js",
        "hwFingerprint.js",
        "content.js",
        "ota-update.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-ui-branding.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-increase-invite-navigation.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-github-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "bundlee-github-mode.js",
        "bundlee-github-launcher.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "payload.js",
        "hwFingerprint.js",
        "powerkits-core.js",
        "powerkits-core.css",
        "jszip.min.js",
        "pageHook.js",
        "drag-blocker.js",
        "icons/*.png",
        "loop.mp4",
        "bundlee-github-mode.js"
      ],
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bundlee_api_redirect",
        "enabled": true,
        "path": "bundlee-backend-redirects.json"
      }
    ]
  }
}
